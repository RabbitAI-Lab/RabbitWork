# 数据库：默认开发态由 scripts/dev.mjs 启动 embedded-postgres 并注入；也可指向外部 PostgreSQL 16
DATABASE_URL=postgresql://localhost:5432/rabbitwork
# Redis：默认开发态使用本机（dev 脚本会尝试复用/以 Docker 拉起，端口见 scripts/rabbit-env.mjs）
REDIS_URL=redis://127.0.0.1:6390/0
# web 应用
WEB_URL=http://localhost:3600
# 会话加密密钥（≥32 字符；首个认证功能落地时启用）
SESSION_SECRET=change-me-to-a-random-32-chars-secret!
# web 与后台 worker 的内部回调/注册令牌
INTERNAL_TOKEN=change-me-internal-token
# MinIO（compose full profile 使用；当前代码未使用）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
