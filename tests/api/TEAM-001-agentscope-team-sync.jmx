        <!-- ④ 未认证 401（Ignore Status：预期 4xx，rules/testing §1.2 勘误先例） -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="04 创建团队-未认证401" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
